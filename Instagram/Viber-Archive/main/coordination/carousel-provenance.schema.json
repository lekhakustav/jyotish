{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sirish24/sirish-utsav-collaboration/blob/main/coordination/carousel-provenance.schema.json",
  "title": "Pinned Instagram carousel provenance manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "edition", "date", "source", "renderer", "brand_assets", "contact_sheet", "slides", "upload_path", "verifier_command"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"const": "jyotish-baje"},
    "edition": {"enum": ["daily", "weekly"]},
    "date": {"pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "upload_path": {"type": "string"},
    "verifier_command": {"type": "string"},
    "source": {"type": "object"},
    "renderer": {"type": "object"},
    "brand_assets": {"type": "array", "minItems": 1},
    "contact_sheet": {"type": "object"},
    "slides": {"type": "array", "minItems": 14, "maxItems": 14}
  }
}
